DISCORD_TOKEN=
DEFAULT_PREFIX=+r
# Identifiants séparés par des virgules. Vide = commandes slash globales.
GUILD_WHITELIST=
# Serveur de référence pour vérifier les rôles, quel que soit le serveur de commande.
ACCESS_GUILD_ID=718583831451402333

# Mode maintenance (bloque l'accès sauf pour MAINTENANCE_BYPASS_ROLE_ID et les OP).
MAINTENANCE=false
# Rôle autorisant les commandes pendant la maintenance.
MAINTENANCE_BYPASS_ROLE_ID=1547275845234724934

# Mode Bêta fermée (seuls les membres dans « data/beta access.json » et les OP peuvent jouer hors /network).
BETA_MODE=false
# Texte affiché dans la présence Discord du bot
BOT_PRESENCE=Root Bot Beta

# Rôle autorisant les commandes admin : ban, unban, guildinfo et shutdown.
OP_ROLE_ID=1547275901954425002

# Base MySQL Root (base vide à créer avant main.py --init-db).
DB_HOST=127.0.0.1
DB_NAME=root
DB_USER=
DB_PASSWORD=

# Salons de logs facultatifs. Vide = pas de log Discord.
LOG_NEW_LANGUAGE_CHANNEL_ID=
LOG_PUBLIC_CHANNEL_ID=
LOG_BLOCKCHAIN_CHANNEL_ID=
LOG_MODERATION_CLAIM_CHANNEL_ID=
LOG_MODERATION_REP_CHANNEL_ID=
LOG_MODERATION_NEW_PLAYER_CHANNEL_ID=
LOG_MODERATION_EVENT_STATS_CHANNEL_ID=
LOG_MODERATION_CLAIM_STATS_CHANNEL_ID=
LOG_MODERATION_HOURLY_STATS_CHANNEL_ID=
LOG_MODERATION_BAN_CHANNEL_ID=
LOG_MODERATION_JOIN_GUILD=
LOG_MODERATION_TRADE_CHANNEL_ID=
LOG_MODERATION_HOURLY_CHANNEL_ID=

# Suivi économique automatique (bilans 1h, 24h, 72h).
# Appliquer migrations/001_economy_reports.sql AVANT de passer ECONOMY_REPORTS_ENABLED à true.
ECONOMY_REPORTS_ENABLED=false
LOG_ECONOMY_1H_CHANNEL_ID=
LOG_ECONOMY_24H_CHANNEL_ID=
LOG_ECONOMY_72H_CHANNEL_ID=
